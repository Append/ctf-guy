# Root-level env for docker-compose. Bot config lives in bot/.env (see bot/.env.example).
CTFD_URL=https://ctf.example.org
CTFD_TOKEN=

# Grafana -> Discord alert webhook, consumed by docker-compose.telemetry.yml
DISCORD_ALERT_WEBHOOK=

# Grafana admin password. The telemetry stack refuses to start if unset.
GRAFANA_ADMIN_PASSWORD=
