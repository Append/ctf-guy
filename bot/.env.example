# picoCTF (for testing)
PICO_USERNAME=
PICO_PASSWORD=

# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=
OPENROUTER_API_KEY=
CTFD_URL=https://ctf.example.org
CTFD_TOKEN=
CTFD_SESSION=                     # Session cookie, fallback when no API token
# Comma-separated Discord user IDs permitted to run commands. The bot refuses to
# start if this is empty, unless ALLOW_ALL_USERS=true is set deliberately.
ALLOWED_USER_IDS=123456789,987654321
ALLOW_ALL_USERS=false
CTF_ROOT=/path/to/ctf-guy
# Shared terminal (/interact)
TTYD_HOST=                        # IP/hostname for terminal URLs (auto-detected if empty)
TTYD_PORT_START=9000              # Port range for ttyd instances
TTYD_PORT_END=9099

# Isolation mode: none (default), tmpfs, bwrap, devcontainer
CTF_ISOLATION=none
DEFAULT_MODEL=anthropic/claude-sonnet-4.6
HEAVY_MODEL=anthropic/claude-opus-4.6
TRIAGE_MODEL=google/gemini-3-flash-preview
AUTOSOLVE_MODEL=haiku
AUTOSOLVE_EFFORT=high
AUTOSOLVE_SUBAGENT=haiku
AUTOSOLVE_CONCURRENCY=10
AUTOSOLVE_TIMEOUT_BASE=180
AUTOSOLVE_TIMEOUT_PER_POINT=3
AUTOSOLVE_TIMEOUT_MAX=600
AUTOSOLVE_MAX_BUDGET=1.0
CLAUDE_CODE_KILL_TIMEOUT=2

# Multi-model racing
RACE_ENABLED=false
RACE_MODELS=haiku,opus
CODEX_ENABLED=false
RACE_TIMEOUTS=                    # Per-model timeout overrides, e.g. haiku=120,codex=180

# Deep analysis
DEEP_ANALYSIS_MODEL=haiku         # Model for teardown subagents

# Manager (solver supervision)
MANAGER_CORRECTIONS=true          # Non-security corrections (security detectors always run)
MANAGER_ADVICE_MODEL=             # Correction model (empty = TRIAGE_MODEL)
MANAGER_MAX_INTERVENTIONS=10      # Max corrections per solve (0 = fully disabled)

# Claude Code
FAST_MODE=false                   # Faster output, higher cost per token

# Ghidra MCP (rev/pwn decompiler; needs uvx pyghidra-mcp)
GHIDRA_MCP_ENABLED=false

# File server for challenge files (0 = disabled)
# Serves challenge files and the /submit + /restart-instance endpoints. A random
# bearer token is generated per run and logged at startup; every route requires it.
FILE_SERVER_PORT=8080
FILE_SERVER_BIND=127.0.0.1        # Set to 0.0.0.0 only if you need remote/tailnet access

# Telemetry (empty = disabled)
VICTORIA_LOGS_URL=                # e.g. http://localhost:9428
VICTORIA_METRICS_URL=             # e.g. http://localhost:8428
TELEMETRY_BATCH_SIZE=50
TELEMETRY_FLUSH_INTERVAL=1.0

# Grafana Discord alerting (used by docker-compose.telemetry.yml)
DISCORD_ALERT_WEBHOOK=
